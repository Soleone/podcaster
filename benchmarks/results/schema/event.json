{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://podcaster.local/schema/benchmarks/event.json",
  "title": "BenchmarkEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "monotonicMs",
    "type",
    "sequence",
    "epoch",
    "detail"
  ],
  "properties": {
    "monotonicMs": {
      "type": "number",
      "minimum": 0
    },
    "type": {
      "enum": [
        "audio_received",
        "speech_start",
        "partial",
        "revision",
        "endpoint",
        "final",
        "tts_requested",
        "first_audio",
        "cancel_requested",
        "silence_observed",
        "underrun",
        "frame_dropped",
        "failure",
        "vram_sample",
        "soak_started",
        "soak_iteration",
        "soak_completed"
      ]
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "epoch": {
      "type": "integer",
      "minimum": 0
    },
    "detail": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceId": {
          "type": "string"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "phase": {
          "enum": [
            "cold",
            "measured"
          ]
        },
        "stage": {
          "enum": [
            "construct",
            "prepare",
            "reset",
            "warmup",
            "transcribe",
            "synthesize",
            "close",
            "finalize",
            "playback",
            "soak"
          ]
        },
        "text": {
          "type": "string"
        },
        "previousText": {
          "type": "string"
        },
        "replacedCharacters": {
          "type": "integer",
          "minimum": 0
        },
        "latencyMs": {
          "type": "number",
          "minimum": 0
        },
        "sampleOffset": {
          "type": "integer",
          "minimum": 0
        },
        "vramBytes": {
          "type": "integer",
          "minimum": 0
        },
        "peakVramBytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "failureCode": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "candidateId": {
          "type": "string",
          "minLength": 1
        },
        "iteration": {
          "type": "integer",
          "minimum": 1
        },
        "expectedFrames": {
          "type": "integer",
          "minimum": 0
        },
        "consumedFrames": {
          "type": "integer",
          "minimum": 0
        },
        "expectedChunks": {
          "type": "integer",
          "minimum": 0
        },
        "consumedChunks": {
          "type": "integer",
          "minimum": 0
        },
        "deadlineOverruns": {
          "type": "integer",
          "minimum": 0
        },
        "droppedFrames": {
          "type": "integer",
          "minimum": 0
        },
        "workerLeaks": {
          "type": "integer",
          "minimum": 0
        },
        "resetCount": {
          "type": "integer",
          "minimum": 0
        },
        "severeFailures": {
          "type": "integer",
          "minimum": 0
        },
        "deadlineLatenessMs": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "sampleCount": {
          "type": "integer",
          "minimum": 0
        },
        "expectedSamples": {
          "type": "integer",
          "minimum": 0
        },
        "consumedSamples": {
          "type": "integer",
          "minimum": 0
        },
        "outputSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "audioDurationSeconds": {
          "type": "number",
          "minimum": 0
        },
        "processingSeconds": {
          "type": "number",
          "minimum": 0
        },
        "peakRssBytes": {
          "type": "integer",
          "minimum": 0
        },
        "droppedOutputChunks": {
          "type": "integer",
          "minimum": 0
        },
        "underruns": {
          "type": "integer",
          "minimum": 0
        },
        "adapterProcessingSeconds": {
          "type": "number",
          "minimum": 0
        },
        "synthesisWindowWholeProcessPeakRssBytes": {
          "type": "integer",
          "minimum": 0
        },
        "underrunEpisodes": {
          "type": "integer",
          "minimum": 0
        },
        "missedSamples": {
          "type": "integer",
          "minimum": 0
        },
        "chunkTelemetry": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sequence",
              "sampleOffset",
              "sampleCount",
              "acceptedMonotonicNs",
              "queuedMonotonicNs",
              "deadlineMonotonicNs",
              "consumeMonotonicNs",
              "arrivalLatenessNs",
              "missedSamples"
            ],
            "properties": {
              "sequence": {
                "type": "integer",
                "minimum": 0
              },
              "sampleOffset": {
                "type": "integer",
                "minimum": 0
              },
              "sampleCount": {
                "type": "integer",
                "minimum": 1
              },
              "acceptedMonotonicNs": {
                "type": "integer",
                "minimum": 0
              },
              "queuedMonotonicNs": {
                "type": "integer",
                "minimum": 0
              },
              "deadlineMonotonicNs": {
                "type": "integer",
                "minimum": 0
              },
              "consumeMonotonicNs": {
                "type": "integer",
                "minimum": 0
              },
              "arrivalLatenessNs": {
                "type": "integer",
                "minimum": 0
              },
              "missedSamples": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    }
  }
}
