{
  "name": "@app/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./binary": {
      "types": "./src/binary.ts",
      "import": "./dist/binary.js"
    },
    "./settings": {
      "types": "./src/settings/index.ts",
      "import": "./dist/settings/index.js"
    },
    "./validators": {
      "types": "./src/validators.ts",
      "import": "./dist/validators.js"
    }
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
