{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://podcaster.local/schema/events/reasoning-started.json",
 "title": "ReasoningStartedEvent",
 "allOf": [
  {
   "$ref": "../protocol-envelope.json"
  },
  {
   "type": "object",
   "required": [
    "type",
    "payload"
   ],
   "properties": {
    "type": {
     "const": "reasoning.started"
    },
    "payload": {
     "type": "object",
     "required": [
      "turnId",
      "responseId",
      "posture"
     ],
     "properties": {
      "turnId": {
       "type": "string",
       "format": "uuid"
      },
      "responseId": {
       "type": "string",
       "format": "uuid"
      },
      "posture": {
       "enum": [
        "riff",
        "question",
        "challenge"
       ]
      }
     },
     "dependentRequired": {},
     "additionalProperties": false
    }
   }
  }
 ]
}
