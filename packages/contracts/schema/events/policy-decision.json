{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://podcaster.local/schema/events/policy-decision.json",
  "title": "PolicyDecisionEvent",
  "allOf": [
    { "$ref": "../protocol-envelope.json" },
    { "type": "object", "required": ["type", "payload"], "properties": {
      "type": { "const": "policy.decision" },
      "payload": { "type": "object", "required": ["turnId", "policyVersion", "eligible", "posture", "reasonCodes", "inputDigest"], "properties": {
        "turnId": { "type": "string", "format": "uuid" },
        "policyVersion": { "const": "v1.experimental" },
        "eligible": { "type": "boolean" },
        "posture": { "enum": ["riff", "question", "challenge", "silence"] },
        "reasonCodes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "inputDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }, "additionalProperties": false }
    } }
  ]
}
