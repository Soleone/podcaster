{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://podcaster.local/schema/events/failure.json",
  "title": "FailureEvent",
  "allOf": [
    { "$ref": "../protocol-envelope.json" },
    { "type": "object", "required": ["type", "payload"], "properties": {
      "type": { "const": "failure" },
      "payload": { "type": "object", "required": ["code", "detail", "correctiveAction", "recoverable"], "properties": {
        "code": { "type": "string", "minLength": 1 },
        "detail": { "type": "string", "minLength": 1 },
        "correctiveAction": { "type": "string", "minLength": 1 },
        "recoverable": { "type": "boolean" }
      }, "additionalProperties": false }
    } }
  ]
}
