{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://podcaster.local/schema/events/playback-stopped.json",
  "title": "PlaybackStoppedEvent",
  "allOf": [
    { "$ref": "../protocol-envelope.json" },
    {
      "type": "object",
      "required": ["type", "payload"],
      "properties": {
        "type": { "const": "playback.stopped" },
        "payload": {
          "type": "object",
          "required": ["playbackId", "cancelledEpoch", "finalPlayedSampleOffset", "reason"],
          "properties": {
            "playbackId": { "type": "string", "format": "uuid" },
            "cancelledEpoch": { "type": "integer", "minimum": 0 },
            "finalPlayedSampleOffset": { "type": "integer", "minimum": 0 },
            "reason": { "enum": ["completed", "cancelled", "stopped", "failed"] }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
