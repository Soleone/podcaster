{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://podcaster.local/schema/benchmarks/run.json",
  "title": "BenchmarkRun",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "kind",
    "startedAt",
    "endedAt",
    "sourceId",
    "dirty",
    "machine",
    "runtimes",
    "models",
    "configId",
    "configSha256",
    "comparisonSemanticsSha256",
    "datasetId",
    "datasetSha256",
    "seed",
    "command",
    "environment",
    "warmups",
    "repetitions",
    "expectedItems",
    "randomization",
    "status"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "runId": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "enum": [
        "synthetic",
        "stt",
        "tts",
        "policy"
      ]
    },
    "startedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "endedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "pattern": "Z$"
    },
    "sourceId": {
      "type": "string",
      "minLength": 1
    },
    "dirty": {
      "type": "boolean"
    },
    "machine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostname",
        "os",
        "kernel",
        "cpu",
        "ramBytes",
        "gpu",
        "driverVersion"
      ],
      "properties": {
        "hostname": {
          "type": "string"
        },
        "os": {
          "type": "string"
        },
        "kernel": {
          "type": "string"
        },
        "cpu": {
          "type": "string"
        },
        "ramBytes": {
          "type": "integer",
          "minimum": 1
        },
        "gpu": {
          "type": "string"
        },
        "driverVersion": {
          "type": "string"
        }
      }
    },
    "runtimes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python",
        "node",
        "cuda",
        "cudnn",
        "pytorch"
      ],
      "properties": {
        "python": {
          "type": "string"
        },
        "node": {
          "type": "string"
        },
        "cuda": {
          "type": "string"
        },
        "cudnn": {
          "type": "string"
        },
        "pytorch": {
          "type": "string"
        }
      }
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "revision",
          "sha256",
          "runtime",
          "precision"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "runtime": {
            "type": "string"
          },
          "precision": {
            "type": "string"
          },
          "voice": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "nativeSampleRate": {
            "type": "integer",
            "minimum": 1
          },
          "modelSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "voicesSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "runtimeRevision": {
            "type": "string"
          },
          "onnxReleaseRevision": {
            "type": "string"
          }
        }
      }
    },
    "configId": {
      "type": "string",
      "minLength": 1
    },
    "configSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "datasetId": {
      "type": "string",
      "minLength": 1
    },
    "datasetSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "seed": {
      "type": "integer"
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cudaVisibleDevices": {
          "type": "string"
        },
        "ompNumThreads": {
          "type": "string"
        },
        "tokenizersParallelism": {
          "enum": [
            "true",
            "false"
          ]
        }
      }
    },
    "warmups": {
      "type": "integer",
      "minimum": 0
    },
    "repetitions": {
      "type": "integer",
      "minimum": 1
    },
    "randomization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "blind",
        "revealLocked"
      ],
      "properties": {
        "method": {
          "type": "string"
        },
        "blind": {
          "type": "boolean"
        },
        "revealLocked": {
          "type": "boolean"
        }
      }
    },
    "status": {
      "enum": [
        "running",
        "passed",
        "failed",
        "cancelled"
      ]
    },
    "comparisonSemantics": {
      "type": "object"
    },
    "comparisonSemanticsSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "expectedItems": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "candidateId",
          "attempt"
        ],
        "properties": {
          "sourceId": {
            "type": "string",
            "minLength": 1
          },
          "candidateId": {
            "type": "string",
            "minLength": 1
          },
          "attempt": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "sourceManifestSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "provenance": {
      "type": "object"
    }
  },
  "if": {
    "properties": {
      "status": {
        "enum": [
          "passed",
          "failed",
          "cancelled"
        ]
      }
    },
    "required": [
      "status"
    ]
  },
  "then": {
    "properties": {
      "endedAt": {
        "type": "string"
      }
    }
  }
}
